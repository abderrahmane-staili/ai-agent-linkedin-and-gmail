      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json) }}",
        "options": {
          "systemMessage": "=You match jobs to this candidate:\n\nJunior Automation & AI Agent Developer.\nSkills: n8n, AI Agents, RAG, LLMs, APIs, PostgreSQL, Supabase, Python, FastAPI, Docker.\nTargets: AI Automation, AI Agents, n8n, Automation, Backend.\nLocation: Morocco, Remote, Europe.\nAvoid: Senior/5+ years/unrelated roles.\n\nScore:\n90-100 APPLY\n75-89 CONSIDER\n60-74 CONSIDER\n<60 IGNORE\n\nEvaluate title, skills, experience and location.\nDo not invent missing information.\n\nReturn ONLY JSON:\n{\n  \"job_id\":\"\",\n  \"title\":\"\",\n  \"company\":null,\n  \"location\":null,\n  \"url\":\"\",\n  \"match\":false,\n  \"score\":0,\n  \"missing_skills\":[],\n  \"reason\":\"\",\n  \"recommendation\":\"APPLY|CONSIDER|IGNORE\"\n}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        512,
        48
      ],
      "id": "1a72186f-a35c-4470-8392-d1e654301bca",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\n\nfunction cleanHtml(html) {\n  return html\n    .replace(/<br\\s*\\/?>/gi, '\\n')\n    .replace(/<\\/p>/gi, '\\n')\n    .replace(/<[^>]+>/g, '')\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#39;|&#x27;/g, \"'\")\n    .replace(/\\u00a0/g, ' ')\n    .replace(/[ \\t]+/g, ' ')\n    .replace(/\\n\\s*\\n+/g, '\\n')\n    .trim();\n}\n\nconst ignored = [\n  /^view job:?$/i,\n  /^apply with resume & profile$/i,\n  /^easy apply$/i,\n  /^apply$/i,\n  /^see job$/i\n];\n\nfor (const item of items) {\n  const html = item.json.textAsHtml || item.json.html || '';\n  const text = item.json.text || '';\n\n  let blocks = html.match(/<p\\b[^>]*>[\\s\\S]*?<\\/p>/gi) || [];\n\n  // Fallback if LinkedIn changes the email HTML structure\n  if (!blocks.length) {\n    blocks = text\n      .split(/View job:\\s*/i)\n      .slice(1)\n      .map(part => part.split(/\\n\\s*\\n/)[0]);\n  }\n\n  for (const block of blocks) {\n    const urlMatch = block.match(\n      /https?:\\/\\/(?:www\\.)?linkedin\\.com\\/(?:comm\\/)?jobs\\/view\\/\\d+\\/?[^\"'<\\s]*/i\n    );\n\n    if (!urlMatch) continue;\n\n    const rawUrl = urlMatch[0];\n\n    const jobIdMatch = rawUrl.match(/jobs\\/view\\/(\\d+)/i);\n    const jobId = jobIdMatch ? jobIdMatch[1] : null;\n\n    const cleanUrl = jobId\n      ? `https://www.linkedin.com/jobs/view/${jobId}/`\n      : rawUrl;\n\n    const content = cleanHtml(block);\n\n    let lines = content\n      .split('\\n')\n      .map(x => x.trim())\n      .filter(Boolean)\n      .filter(x => !/^view job:?/i.test(x))\n      .filter(x => !ignored.some(re => re.test(x)));\n\n    if (!lines.length) continue;\n\n    const title = lines[0] || null;\n    const company = lines.length >= 3 ? lines[1] : null;\n    const location = lines.length >= 3 ? lines[2] : (lines[1] || null);\n\n    output.push({\n      json: {\n        job_id: jobId,\n        title,\n        company,\n        location,\n        url: cleanUrl,\n        source: 'LinkedIn',\n        details: lines,\n        email_subject: item.json.subject || ''\n      }\n    });\n  }\n}\n\nreturn output;"
      },
